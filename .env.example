# Backend
APP_ENV=development
DATA_MODE=replay
LOG_LEVEL=info

# FortyGuard — backend only. Never expose to the frontend.
FORTYGUARD_API_KEY=
FORTYGUARD_BASE_URL=https://api.fortyguard.com

# CORS / public URL
API_PUBLIC_URL=http://localhost:8000
WEB_PUBLIC_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Cache
CACHE_DIR=.cache/fortyguard

# Docker / Render (set by compose or the host; never commit values for production URLs)
# PORT=
# API_UPSTREAM=

# Hosted shipping matrix. Replay only. Client cannot flip these.
HOSTED_LIVE_ENABLED=false
HOSTED_LIVE_REAL_VENDOR_ENABLED=false
DEMO_ALLOWANCE_ENABLED=false
DEMO_ALLOWANCE_MAX_TOTAL_UNITS=0
OPERATOR_APPROVAL_ENABLED=false
LOCAL_SQLITE_PERSISTENCE_ENABLED=false
HVA_PUBLIC_SAFETY_MIDDLEWARE=1

# RC-v3 public features. Cache-only. Does not enable hosted live or vendor HTTP.
HVA_PUBLIC_CONTEXT=1
HVA_PUBLIC_TEMPORAL_STORIES=1
HVA_PUBLIC_TWO_SIGNAL=0
HVA_PUBLIC_GEOGRAPHY=0

# Frontend Vite pair. Bake the same values into the web image.
# Unset VITE_HVA_PUBLIC_CONTEXT also defaults ON in publicContextGate.ts;
# keep this explicit so hosted cannot silently lose context chrome.
VITE_HVA_PUBLIC_CONTEXT=1
VITE_HVA_PLACE_SEARCH=0
VITE_HVA_PLACE_SEARCH_API=0
VITE_HVA_LIVE_DEMO_CONFIRMATION=0
# Judge shell stays default ON unless VITE_HVA_JUDGE_SHELL=0
