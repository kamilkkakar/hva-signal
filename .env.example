# Backend
APP_ENV=development
DATA_MODE=replay
LOG_LEVEL=info

# FortyGuard — backend only. Never expose to the frontend.
FORTYGUARD_API_KEY=
FORTYGUARD_BASE_URL=https://api.fortyguard.com

# CORS / public URL
API_PUBLIC_URL=http://localhost:8000
WEB_PUBLIC_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Cache
CACHE_DIR=.cache/fortyguard

# Docker / Render (set by compose or the host; never commit values for production URLs)
# PORT=
# API_UPSTREAM=

# RC-v2 analysis-area context. Default on. Set either to 0 to disable.
# Cache-only phoenix-demo. Does not enable hosted live or two-signal HTTP.
HVA_PUBLIC_CONTEXT=1
VITE_HVA_PUBLIC_CONTEXT=1
